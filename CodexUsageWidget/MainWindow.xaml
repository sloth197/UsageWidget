<Window x:Class="CodexUsageWidget.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="310" Height="166" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True">
 <Window.Resources>
  <Style x:Key="OpacitySliderStyle" TargetType="Slider">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid Height="16" Background="Transparent">
       <Track x:Name="PART_Track" VerticalAlignment="Center" Height="10">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="Slider.DecreaseLarge" BorderThickness="0" Padding="0" Focusable="False">
          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#5C87FF" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
         </RepeatButton>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb Width="10" Height="10">
          <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#E1E6F2"/></ControlTemplate></Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="Slider.IncreaseLarge" BorderThickness="0" Padding="0" Focusable="False">
          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#404450" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
         </RepeatButton>
        </Track.IncreaseRepeatButton>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="Root_Down" MouseMove="Root_Move" MouseLeftButtonUp="Root_Up">
  <Path x:Name="Blob" Fill="#181A21" Stretch="None" IsHitTestVisible="False"/>
  <Grid Margin="18,12,18,11">
   <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <TextBlock Text="CODEX  USAGE" Foreground="#96A0B4" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
    <Slider x:Name="OpacitySlider" Style="{StaticResource OpacitySliderStyle}" Minimum="0.4" Maximum="1" Value="1" Width="48" Height="16" HorizontalAlignment="Right" Margin="0,0,50,0" ValueChanged="Opacity_Changed"/>
    <Button Content="↻" Width="24" Height="22" HorizontalAlignment="Right" Margin="0,0,24,0" Background="Transparent" Foreground="#9196A5" BorderThickness="0" Click="Refresh_Click"/>
    <Button Content="×" Width="24" Height="22" HorizontalAlignment="Right" Background="Transparent" Foreground="#9196A5" BorderThickness="0" FontSize="16" Click="Close_Click"/>
   </Grid>
   <StackPanel x:Name="UsageRows" Grid.Row="1" Margin="0,2,0,0"/>
   <TextBlock x:Name="Status" Grid.Row="2" Text="연결 중…" Foreground="#828C9E" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Bottom"/>
  </Grid>
 </Grid>
</Window>
